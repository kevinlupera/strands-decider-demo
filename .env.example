# Where the local Strands Decider server is listening (default shown).
# Start it with:
#   strands-decider serve StrandsAgents/strands-decider-2B-hobson-v19 --port 8099
STRANDS_DECIDER_URL=http://127.0.0.1:8099

# guardrail_demo.py (without --fallback) drives a Strands agent on Amazon Bedrock,
# so it needs AWS credentials with Bedrock access. Pick ONE of:

# Development API key (expires in ~30 days):
# AWS_BEDROCK_API_KEY=your_bedrock_api_key

# Or standard AWS credentials:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-west-2
